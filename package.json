{
  "name": "rsql-builder",
  "version": "1.4.1",
  "description": "RSQL query builder",
  "keywords": [
    "builder",
    "query",
    "rsql"
  ],
  "homepage": "https://github.com/RomiC/rsql-builder#readme",
  "bugs": {
    "url": "https://github.com/RomiC/rsql-builder/issues"
  },
  "license": "MIT",
  "author": "Roman Charugin <romic+github@fastmail.com>",
  "contributors": [
    "Roman Charugin <romic+github@fastmail.com>",
    "Mihael Šafarić <mihael.safaric@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomiC/rsql-builder.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:test": "tsdown -c tsdown.tests.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "precommit": "lint-staged",
    "prepare": "husky",
    "prepush": "npm run test && npm run test:smoke",
    "pretest": "npm run build:test",
    "pretest:no-coverage": "npm run build:test",
    "pretest:smoke": "npm run build",
    "test": "c8 --reporter=text --reporter=lcov --include=dist node --test tests/*.spec.js",
    "test:smoke": "node ./scripts/smoke-cjs.cjs && node ./scripts/smoke-esm.mjs",
    "test:no-coverage": "node --test tests/*.spec.js"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "c8": "^12.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.80.0",
    "tsdown": "0.22.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "yargs": "^18.0.0"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": "npm run lint:fix",
    "*.{js,ts,mjs,cjs,json,md,yml,yaml}": "npm run format"
  },
  "engines": {
    "node": ">= 22"
  }
}
